# Copy this file to .env and fill in your OWN values. .env is never committed.

# Which AI provider the assessment uses: openrouter or gemini
AI_PROVIDER=openrouter

# OpenRouter: create your own key at https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_NAME=

# Gemini: create your own key in Google AI Studio (only if AI_PROVIDER=gemini)
GEMINI_API_KEY=

# How many programs / APIs go into one AI request
ASSESSMENT_BATCH_MAX_OBJECTS=11
